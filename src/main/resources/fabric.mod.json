{
  "schemaVersion": 1,
  "id": "nametaglines",
  "version": "${version}",
  "name": "NameTagMod",
  "description": "NameTagMod by MelonKingDe: extra lines (with scale, custom PNG icons and chroma text) above and below your own nametag, client-side only.",
  "license": "MIT",
  "icon": "assets/nametaglines/icon.png",
  "authors": ["MelonKingDe"],
  "environment": "client",
  "entrypoints": {
    "client": ["de.example.nametaglines.NametagLinesClient"]
  },
  "mixins": [
    { "config": "nametaglines.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
